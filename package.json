{
  "name": "property-domain-academy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run validate:curriculum",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:app": "node --test tests/app-bundle.test.mjs",
    "test:unit": "tsx --test tests/lesson-route.test.ts tests/glossary.test.ts",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "validate:curriculum": "tsx scripts/validate-curriculum.ts",
    "test": "npm run validate:curriculum && npm run test:unit && npm run test:app && npm run test:sites"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@vitejs/plugin-react": "5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.18",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.25.12",
    "tailwindcss": "4.1.18",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
